# Copy to .env before running.
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
# Comma-separated origins allowed to call the API (native apps don't need CORS,
# this matters if you also test from a browser / simulator webview).
CORS_ORIGIN="*"

# Stripe Billing (test mode) — see src/services/billing.ts for the full setup
# steps. Leave unset and /admin/billing just returns 400s; everything else
# in the app works fine without it.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_SOLO=""
STRIPE_PRICE_ESTUDIO=""
STRIPE_PRICE_CADENA=""
# Where Stripe Checkout/Portal redirect back to after a payment flow.
APP_BASE_URL="http://localhost:5173"

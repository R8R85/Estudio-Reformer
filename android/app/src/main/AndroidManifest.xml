<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="Estudio Reformer"
        android:theme="@style/Theme.EstudioReformer"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic: dev/demo only — the backend runs on plain
             HTTP against localhost/LAN. Switch to HTTPS and drop this once
             the API has a real domain + certificate. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.EstudioReformer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
